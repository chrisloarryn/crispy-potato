# Ejemplo de configuración de variables de entorno
# Copia este archivo a .env y modifica los valores según tu configuración

# Base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/twittor
# Para MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/twittor?retryWrites=true&w=majority

# Clave secreta para JWT (¡CAMBIAR EN PRODUCCIÓN!)
JWT_SECRET=MastersOfDevelopment_facebookGroup

# Puerto del servidor
PORT=8080

# Ruta base para almacenamiento de archivos
STORAGE_PATH=.

# Configuración para Docker Compose
# MONGODB_URI=mongodb://mongodb:27017/twittor
